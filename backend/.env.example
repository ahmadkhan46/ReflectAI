# ============================================================
# ReflectAI Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME=ReflectAI
APP_ENV=development
DEBUG=true

# Security — generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_at_least_64_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — matches docker-compose defaults
DATABASE_URL=postgresql+asyncpg://reflectai:reflectai_dev_password@localhost:5432/reflectai

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_run_the_command_above_to_generate

# Email — use Mailtrap (https://mailtrap.io) for development
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
EMAILS_FROM=noreply@reflectai.app

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
